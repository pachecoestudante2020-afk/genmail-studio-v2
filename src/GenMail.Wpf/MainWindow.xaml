<Window x:Class="GenMail.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenMail Studio" Height="800" Width="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <GroupBox Header="Input"><StackPanel Orientation="Horizontal"><TextBox Width="700" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Content="Browse .txt" Command="{Binding BrowseInputFileCommand}"/></StackPanel></GroupBox>
            <GroupBox Header="Domain" Margin="0,8,0,0"><TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"/></GroupBox>
            <GroupBox Header="Rules" Margin="0,8,0,0"><StackPanel><ItemsControl ItemsSource="{Binding RuleItems}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}"><TextBlock Text="{Binding Id}"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal"><Button Content="Select all" Command="{Binding SelectAllRulesCommand}"/><Button Content="Clear all" Margin="8,0,0,0" Command="{Binding ClearAllRulesCommand}"/><Button Content="Defaults" Margin="8,0,0,0" Command="{Binding DefaultsRulesCommand}"/></StackPanel></StackPanel></GroupBox>
            <GroupBox Header="Number settings" Margin="0,8,0,0"><StackPanel><ComboBox ItemsSource="{Binding NumberModes}" SelectedItem="{Binding NumberMode}"/><ComboBox Margin="0,4,0,0" ItemsSource="{Binding NumberPlacementModes}" SelectedItem="{Binding NumberPlacementMode}"/><TextBox Margin="0,4,0,0" Text="{Binding NumberRangeText}"/></StackPanel></GroupBox>
            <GroupBox Header="Modes" Margin="0,8,0,0"><StackPanel><ComboBox ItemsSource="{Binding DedupeModes}" SelectedItem="{Binding DedupeMode}"/><ComboBox Margin="0,4,0,0" ItemsSource="{Binding AliasFilterModes}" SelectedItem="{Binding AliasFilterMode}"/></StackPanel></GroupBox>
            <GroupBox Header="Safety settings" Margin="0,8,0,0"><StackPanel><TextBox Text="{Binding MaxOutputEmails}"/><TextBox Margin="0,4,0,0" Text="{Binding MaxNumbersPerBase}"/><CheckBox Margin="0,6,0,0" Content="Split output into multiple files" IsChecked="{Binding SplitOutputFiles}"/><TextBox Margin="0,4,0,0" Text="{Binding RowsPerOutputFile}" IsEnabled="{Binding SplitOutputFiles}"/><TextBlock Text="The app will not generate extra data to fill files. The last file may contain fewer rows." TextWrapping="Wrap"/></StackPanel></GroupBox>
            <GroupBox Header="Progress" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding InputLinesRead, StringFormat=Input lines: {0}}"/><TextBlock Text="{Binding UsernamesGenerated, StringFormat=Usernames generated: {0}}"/><TextBlock Text="{Binding EmailsWritten, StringFormat=Emails written: {0}}"/><TextBlock Text="{Binding DuplicatesSkipped, StringFormat=Duplicates skipped: {0}}"/><TextBlock Text="{Binding QualityRejected, StringFormat=Quality rejected: {0}}"/><TextBlock Text="{Binding StatusText, StringFormat=Status: {0}}"/></StackPanel></GroupBox>
            <GroupBox Header="Output" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><TextBox Width="700" Text="{Binding OutputFolder}"/><Button Margin="8,0,0,0" Content="Open Folder" Command="{Binding OpenOutputFolderCommand}"/></StackPanel></GroupBox>
            <GroupBox Header="Actions" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Button Content="Estimate" Command="{Binding EstimateCommand}"/><Button Content="Start" Margin="8,0,0,0" Command="{Binding StartCommand}"/><Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"/></StackPanel></GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
